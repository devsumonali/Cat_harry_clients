# Public Express API URL (keep this separate from the Next.js auth URL).
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# Authentication runs on Next.js. Use the deployed frontend URL in production.
BETTER_AUTH_URL=http://localhost:3000
# Generate your own: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS

# Local MongoDB example. Replace with your MongoDB Atlas connection string if needed.
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB_NAME=studiospace_db

# Google OAuth client type: Web application
# Authorized JavaScript origin: http://localhost:3000
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET
